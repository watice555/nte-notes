---
import BaseLayout from "@/components/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import links from "@/data/links.json";

const groups = [
  {
    key: "Wiki",
    title: "Wiki 类",
    description: "资料站、Wiki 和攻略索引。",
  },
  {
    key: "社区",
    title: "社区",
    description: "玩家讨论、视频和社区内容入口。",
  },
  {
    key: "官方",
    title: "官方",
    description: "不同地区的官方网站入口，亦是下载入口。",
  },
];

const categoryLabels: Record<string, string> = {
  Wiki: "Wiki",
  社区: "社区",
  官方: "官方",
};
---

<BaseLayout title="外部链接" active="/links/">
  <PageHero
    eyebrow="链接"
    title="外部链接"
    description="整理官网、下载、Wiki、社区、工具站等入口。链接会尽量标注来源和用途。"
  />

  {
    groups.map((group) => {
      const items = links.filter((link) => link.category === group.key);
      if (items.length === 0) return null;

      return (
        <section>
          <SectionHeader
            title={group.title}
            description={group.description}
          />
          <div class="grid two">
            {items.map((link) => (
              <article class="data-card">
                <div class="meta-row">
                  <span class="pill">{categoryLabels[link.category] ?? link.category}</span>
                </div>
                <h3>{link.title}</h3>
                <p>{link.summary}</p>
                <p>
                  <a
                    class="external-link"
                    href={link.url}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {link.url}
                  </a>
                </p>
              </article>
            ))}
          </div>
        </section>
      );
    })
  }
</BaseLayout>
