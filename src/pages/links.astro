---
import BaseLayout from "@/components/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import links from "@/data/links.json";

type LocalizedUrl = string | { zh?: string; en?: string };

const getUrl = (url: LocalizedUrl, lang: "zh" | "en") => {
  if (typeof url === "string") return url;
  return url[lang] ?? url.zh ?? url.en ?? "";
};

const groups = [
  {
    key: "Wiki",
    title: "Wiki 类",
    titleEn: "Wikis",
    description: "资料站、Wiki 和攻略索引。",
    descriptionEn: "Reference sites, wikis, and guide indexes.",
  },
  {
    key: "社区",
    title: "社区",
    titleEn: "Communities",
    description: "玩家讨论、视频和社区内容入口。",
    descriptionEn: "Player discussion, video, and community portals.",
  },
  {
    key: "官方",
    title: "官方",
    titleEn: "Official",
    description: "不同地区的官方网站入口，亦是下载入口。",
    descriptionEn: "Official sites for different regions, including download pages.",
  },
];

const categoryLabels: Record<string, { zh: string; en: string }> = {
  Wiki: { zh: "Wiki", en: "Wiki" },
  社区: { zh: "社区", en: "Community" },
  官方: { zh: "官方", en: "Official" },
};
---

<BaseLayout title="外部链接" active="/links/">
  <PageHero
    eyebrow="External Links"
    title="外部链接"
    titleEn="External Links"
    description="整理官网、下载、Wiki、社区、工具站等入口。链接会尽量标注来源和用途。"
    descriptionEn="Official, download, wiki, community, and tool links."
  />

  {
    groups.map((group) => {
      const items = links.filter((link) => link.category === group.key);
      if (items.length === 0) return null;

      return (
        <section>
          <SectionHeader
            title={group.title}
            titleEn={group.titleEn}
            description={group.description}
            descriptionEn={group.descriptionEn}
          />
          <div class="grid two">
            {items.map((link) => (
              (() => {
                const urlZh = getUrl(link.url, "zh");
                const urlEn = getUrl(link.url, "en");

                return (
              <article class="data-card">
                <div class="meta-row">
                  <span
                    class="pill"
                    data-i18n-zh={categoryLabels[link.category]?.zh ?? link.category}
                    data-i18n-en={categoryLabels[link.category]?.en ?? link.category}
                  >
                    {categoryLabels[link.category]?.zh ?? link.category}
                  </span>
                </div>
                <h3 data-i18n-zh={link.title.zh} data-i18n-en={link.title.en}>{link.title.zh}</h3>
                <p data-i18n-zh={link.summary.zh} data-i18n-en={link.summary.en}>{link.summary.zh}</p>
                <p>
                  <a
                    class="external-link"
                    href={urlZh}
                    target="_blank"
                    rel="noreferrer"
                    data-i18n-zh={urlZh}
                    data-i18n-en={urlEn}
                    data-i18n-href-zh={urlZh}
                    data-i18n-href-en={urlEn}
                  >
                    {urlZh}
                  </a>
                </p>
              </article>
                );
              })()
            ))}
          </div>
        </section>
      );
    })
  }
</BaseLayout>
