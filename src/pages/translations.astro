---
import BaseLayout from "@/components/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import translations from "@/data/translations.json";

const categoryLabels: Record<string, string> = {
  游戏名: "Game Title",
  世界观: "World",
  角色: "Character",
  属性: "Attribute",
  弧盘类别: "Arc Type",
  武器: "Weapon",
  怪物: "Monster",
};
const categories = Array.from(new Set(translations.map((item) => item.category)));
---

<BaseLayout title="中英对照" active="/translations/">
  <PageHero
    eyebrow="CN / EN Reference"
    title="中英对照"
    titleEn="Chinese / English Reference"
    description="用于查询角色名、地点、道具、系统名词等中英对照。持续建设中~"
    descriptionEn="A searchable Chinese and English reference for names, places, items, and systems. Work in progress."
  />

  <SectionHeader title="对照表" titleEn="Reference Table" />
  <div class="tool-row">
    <input
      class="filter-input"
      type="search"
      data-table-filter
      placeholder="搜索中文、英文或分类..."
      data-i18n-placeholder-zh="搜索中文、英文或分类..."
      data-i18n-placeholder-en="Search Chinese, English, or category..."
    />
  </div>
  <fieldset class="category-filter" data-category-filters>
    <legend data-i18n-zh="按分类筛选" data-i18n-en="Filter by category">按分类筛选</legend>
    <div class="category-filter-options">
      {
        categories.map((category) => (
          <label class="category-filter-option">
            <input type="checkbox" value={category} data-category-filter checked />
            <span data-i18n-zh={category} data-i18n-en={categoryLabels[category] ?? category}>
              {category}
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>
  <table class="data-table" data-filter-table>
    <thead>
      <tr>
        <th data-i18n-zh="中文" data-i18n-en="Chinese">中文</th>
        <th>English</th>
        <th data-i18n-zh="分类" data-i18n-en="Category">分类</th>
      </tr>
    </thead>
    <tbody>
      {
        translations.map((item) => (
          <tr data-filter-text={`${item.zh} ${item.en} ${item.category}`} data-category={item.category}>
            <td>{item.zh}</td>
            <td lang="en">{item.en}</td>
            <td data-i18n-zh={item.category} data-i18n-en={categoryLabels[item.category] ?? item.category}>
              {item.category}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</BaseLayout>

<script>
  // @ts-nocheck
  const tableFilter = document.querySelector("[data-table-filter]");
  const categoryFilters = Array.from(document.querySelectorAll("[data-category-filter]"));
  const rows = Array.from(document.querySelectorAll("[data-filter-text]"));

  const updateTable = () => {
    const query = tableFilter?.value.trim().toLowerCase() || "";
    const selectedCategories = new Set(
      categoryFilters.filter((filter) => filter.checked).map((filter) => filter.value),
    );

    rows.forEach((row) => {
      const text = row.getAttribute("data-filter-text")?.toLowerCase() || "";
      const category = row.getAttribute("data-category") || "";
      const matchesQuery = query.length === 0 || text.includes(query);
      const matchesCategory = selectedCategories.has(category);
      row.hidden = !matchesQuery || !matchesCategory;
    });
  };

  tableFilter?.addEventListener("input", updateTable);
  categoryFilters.forEach((filter) => filter.addEventListener("change", updateTable));
</script>
