---
import BaseLayout from "@/components/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import translations from "@/data/translations.json";

const categoryLabels: Record<string, string> = {
  游戏名: "Game Title",
  世界观: "World",
  角色: "Character",
  属性: "Attribute",
  弧盘类别: "Arc Type",
};
---

<BaseLayout title="中英对照" active="/translations/">
  <PageHero
    eyebrow="CN / EN Reference"
    title="中英对照"
    titleEn="Chinese / English Reference"
    description="用于查询角色名、地点、道具、系统名词等中英对照。持续建设中~"
    descriptionEn="A searchable Chinese and English reference for names, places, items, and systems. Work in progress."
  />

  <SectionHeader title="对照表" titleEn="Reference Table" />
  <div class="tool-row">
    <input
      class="filter-input"
      type="search"
      data-table-filter
      placeholder="搜索中文、英文、别名、分类..."
      data-i18n-placeholder-zh="搜索中文、英文、别名、分类..."
      data-i18n-placeholder-en="Search Chinese, English, aliases, or categories..."
    />
  </div>
  <table class="data-table" data-filter-table>
    <thead>
      <tr>
        <th data-i18n-zh="中文" data-i18n-en="Chinese">中文</th>
        <th>English</th>
        <th data-i18n-zh="分类" data-i18n-en="Category">分类</th>
        <th data-i18n-zh="别名" data-i18n-en="Aliases">别名</th>
        <th data-i18n-zh="备注" data-i18n-en="Notes">备注</th>
      </tr>
    </thead>
    <tbody>
      {
        translations.map((item) => (
          <tr data-filter-text={`${item.zh} ${item.en} ${item.category} ${item.aliases.join(" ")} ${item.note.zh} ${item.note.en}`}>
            <td>{item.zh}</td>
            <td lang="en">{item.en}</td>
            <td data-i18n-zh={item.category} data-i18n-en={categoryLabels[item.category] ?? item.category}>
              {item.category}
            </td>
            <td>{item.aliases.join(" / ")}</td>
            <td data-i18n-zh={item.note.zh} data-i18n-en={item.note.en}>{item.note.zh}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</BaseLayout>

<script>
  // @ts-nocheck
  const tableFilter = document.querySelector("[data-table-filter]");
  const rows = Array.from(document.querySelectorAll("[data-filter-text]"));

  tableFilter?.addEventListener("input", () => {
    const query = tableFilter.value.trim().toLowerCase();
    rows.forEach((row) => {
      const text = row.getAttribute("data-filter-text")?.toLowerCase() || "";
      row.hidden = query.length > 0 && !text.includes(query);
    });
  });
</script>
