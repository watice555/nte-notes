---
import BaseLayout from "@/components/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import terms from "@/data/terms.json";
---

<BaseLayout title="名词解释" active="/terms/">
  <PageHero
    eyebrow="Glossary"
    title="名词解释"
    titleEn="Glossary"
    description="整理养成系统和玩法系统中的专有名词，并提供与原神等游戏概念的近似对应。"
    descriptionEn="NTE terms with compact explanations and approximate comparisons."
    quips={["万物起原"]}
  />

  <SectionHeader
    title="术语"
    titleEn="Terms"
    description="“近似对应”只用于帮助理解，不代表系统机制完全等同。"
    descriptionEn="Comparisons are only for orientation and may not be exact."
  />
  <div class="grid two">
    {
      terms.map((term) => (
        <article class="data-card">
          <div class="meta-row">
            <span class="pill">{term.category}</span>
            {term.tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
          <h3 data-i18n-zh={term.term.zh} data-i18n-en={term.term.en}>{term.term.zh}</h3>
          <p data-i18n-zh={term.genshinEquivalent.zh} data-i18n-en={term.genshinEquivalent.en}>
            {term.genshinEquivalent.zh}
          </p>
          <p data-i18n-zh={term.explanation.zh} data-i18n-en={term.explanation.en}>
            {term.explanation.zh}
          </p>
        </article>
      ))
    }
  </div>
</BaseLayout>
