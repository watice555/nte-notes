---
import BaseLayout from "@/components/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import terms from "@/data/terms.json";
---

<BaseLayout title="名词解释" active="/terms/">
  <PageHero
    eyebrow="术语"
    title="名词解释"
    description="整理养成系统和玩法系统中的专有名词，并提供与原神中游戏概念的对应参考。"
    quips={["万物起原"]}
  />

  <SectionHeader
    title="术语"
    description="原神概念仅用于帮助理解，不代表系统机制完全等同。"
  />
  <div class="grid two">
    {
      terms.map((term) => (
        <article class="data-card">
          <div class="term-pair">
            <h3>{term.term}</h3>
            <span class="term-equivalent">{term.genshinEquivalent}</span>
          </div>
          <p>{term.explanation}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>
