---
import BaseLayout from "@/components/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import affinity from "@/data/affinity.json";

const formatter = new Intl.NumberFormat("zh-CN");
---

<BaseLayout title="好感度" active="/affinity/">
  <PageHero
    eyebrow="好感度"
    title="好感度"
    description="整理角色好感提升方式、赠礼性价比与升级需求。"
    quips={["投其所好，少走弯路"]}
  />

  <section>
    <SectionHeader
      title="提升方式"
      description="可通过赠礼、剧情、互动等方式提升好感度。"
    />
    <div class="grid">
      {
        affinity.methods.map((method) => (
          <article class="data-card">
            <h3>{method.title}</h3>
            <p>{method.summary}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <SectionHeader
      title="赠礼性价比"
      description="各角色在 400、200、100 好感度档位中价格最低的赠礼，同价礼物并列展示。"
    />
    <div class="table-scroll">
      <table class="data-table affinity-table">
        <thead>
          <tr>
            <th>角色</th>
            {
              affinity.giftTiers.map((tier) => (
                <th>{tier} 好感度</th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            affinity.gifts.map((row) => (
              <tr>
                <th scope="row">{row.character}</th>
                {
                  affinity.giftTiers.map((tier) => {
                    const gift = row.best[String(tier) as keyof typeof row.best];

                    return (
                      <td>
                        <span class="gift-name">{gift.name}</span>
                        <span class="gift-value">{formatter.format(gift.value)}</span>
                      </td>
                    );
                  })
                }
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <SectionHeader
      title="升级需求"
      description="好感度等级提升所需数值。"
    />
    <div class="table-scroll level-table-wrap">
      <table class="data-table level-table">
        <thead>
          <tr>
            <th>等级</th>
            <th>所需好感度</th>
          </tr>
        </thead>
        <tbody>
          {
            affinity.levels.map((level) => (
              <tr>
                <td>{level.from}级→{level.to}级</td>
                <td>{formatter.format(level.required)}</td>
              </tr>
            ))
          }
          <tr class="total-row">
            <td>合计</td>
            <td>{formatter.format(affinity.totalRequired)}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>
