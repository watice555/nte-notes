---
import BaseLayout from "@/components/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import characters from "@/data/characters.json";

const uniqueByZh = (values: Array<{ zh: string; en: string }>) =>
  Array.from(new Map(values.map((value) => [value.zh, value])).values());

const filterGroups = [
  {
    key: "rarity",
    label: { zh: "稀有度", en: "Rarity" },
    options: Array.from(new Set(characters.map((character) => character.rarity))).map((rarity) => ({
      zh: rarity,
      en: rarity,
    })),
  },
  {
    key: "role",
    label: { zh: "定位", en: "Role" },
    options: uniqueByZh(characters.map((character) => character.role)),
  },
  {
    key: "gender",
    label: { zh: "性别", en: "Gender" },
    options: uniqueByZh(characters.map((character) => character.gender)),
  },
  {
    key: "attribute",
    label: { zh: "属性", en: "Attribute" },
    options: uniqueByZh(characters.map((character) => character.attribute)),
  },
  {
    key: "arcType",
    label: { zh: "弧盘类型", en: "Arc Type" },
    options: uniqueByZh(characters.map((character) => character.arcType)),
  },
];
---

<BaseLayout title="角色信息" active="/characters/">
  <PageHero
    eyebrow="Characters"
    title="角色信息"
    titleEn="Characters"
    description="角色基础信息。持续建设中~"
    descriptionEn="Basic character information. Work in progress."
  />

  <SectionHeader title="角色索引" titleEn="Character Index" />
  <div class="filter-panel" data-character-filters>
    {
      filterGroups.map((group) => (
        <label class="filter-control">
          <span data-i18n-zh={group.label.zh} data-i18n-en={group.label.en}>{group.label.zh}</span>
          <select data-character-filter={group.key}>
            <option value="" data-i18n-zh="全部" data-i18n-en="All">全部</option>
            {group.options.map((option) => (
              <option value={option.zh} data-i18n-zh={option.zh} data-i18n-en={option.en}>
                {option.zh}
              </option>
            ))}
          </select>
        </label>
      ))
    }
  </div>
  <p
    class="filter-count"
    data-character-count
    data-i18n-zh={`显示 ${characters.length} 位角色`}
    data-i18n-en={`Showing ${characters.length} characters`}
  >
    显示 {characters.length} 位角色
  </p>
  <div class="grid">
    {
      characters.map((character) => (
        <article
          class="data-card"
          data-character-card
          data-rarity={character.rarity}
          data-role={character.role.zh}
          data-gender={character.gender.zh}
          data-attribute={character.attribute.zh}
          data-arc-type={character.arcType.zh}
        >
          <div class="character-card-head">
            <h3 data-i18n-zh={character.name.zh} data-i18n-en={character.name.en}>{character.name.zh}</h3>
            <div class="character-badges">
              <span class="rarity-pill" data-rarity-tier={character.rarity}>
                {character.rarity}
              </span>
              <span class="tag" data-i18n-zh={character.role.zh} data-i18n-en={character.role.en}>
                {character.role.zh}
              </span>
            </div>
          </div>
          <dl class="character-facts">
            <div>
              <dt data-i18n-zh="性别" data-i18n-en="Gender">性别</dt>
              <dd data-i18n-zh={character.gender.zh} data-i18n-en={character.gender.en}>{character.gender.zh}</dd>
            </div>
            <div>
              <dt data-i18n-zh="属性" data-i18n-en="Attribute">属性</dt>
              <dd data-i18n-zh={character.attribute.zh} data-i18n-en={character.attribute.en}>{character.attribute.zh}</dd>
            </div>
            <div>
              <dt data-i18n-zh="弧盘类型" data-i18n-en="Arc Type">弧盘类型</dt>
              <dd data-i18n-zh={character.arcType.zh} data-i18n-en={character.arcType.en}>{character.arcType.zh}</dd>
            </div>
          </dl>
          <p data-i18n-zh={character.summary.zh} data-i18n-en={character.summary.en}>{character.summary.zh}</p>
        </article>
      ))
    }
  </div>
</BaseLayout>

<script>
  // @ts-nocheck
  const filterSelects = Array.from(document.querySelectorAll("[data-character-filter]"));
  const characterCards = Array.from(document.querySelectorAll("[data-character-card]"));
  const characterCount = document.querySelector("[data-character-count]");
  const filterKeyToAttribute = {
    rarity: "data-rarity",
    role: "data-role",
    gender: "data-gender",
    attribute: "data-attribute",
    arcType: "data-arc-type",
  };

  const setCountText = (visibleCount) => {
    if (!characterCount) return;
    const zh = `显示 ${visibleCount} 位角色`;
    const en = `Showing ${visibleCount} characters`;
    characterCount.setAttribute("data-i18n-zh", zh);
    characterCount.setAttribute("data-i18n-en", en);
    characterCount.textContent = document.body.dataset.lang === "en" ? en : zh;
  };

  const updateCharacterFilters = () => {
    let visibleCount = 0;
    characterCards.forEach((card) => {
      const isVisible = filterSelects.every((select) => {
        const value = select.value;
        if (!value) return true;
        const attribute = filterKeyToAttribute[select.dataset.characterFilter];
        return card.getAttribute(attribute) === value;
      });
      card.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });
    setCountText(visibleCount);
  };

  filterSelects.forEach((select) => {
    select.addEventListener("change", updateCharacterFilters);
  });
</script>
