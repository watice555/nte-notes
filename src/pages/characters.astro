---
import BaseLayout from "@/components/BaseLayout.astro";
import CharacterPoolCard from "@/components/CharacterPoolCard.astro";
import PageHero from "@/components/PageHero.astro";
import characters from "@/data/characters.json";

interface PoolInfo {
  version: string;
  phase: string;
  name: string;
  start: string;
  end: string;
}

interface Character {
  id: string;
  name: string;
  rarity: string;
  gender: string;
  attribute: string;
  arcType: string;
  role: string;
  summary: string;
  pool?: PoolInfo;
}

interface Rerun {
  phase: string;
  characterId: string;
  characterName: string;
}

interface VersionMeta {
  version: string;
  title: string;
  reruns?: Rerun[];
}

const allCharacters = characters as Character[];
const versionMeta: VersionMeta[] = [
  {
    version: "1.3",
    title: "雾中朔望星回",
    reruns: [
      { phase: "上半", characterId: "nanally", characterName: "娜娜莉" },
      { phase: "下半", characterId: "hotori", characterName: "浔" },
    ],
  },
  { version: "1.2", title: "九百九十九夜" },
  { version: "1.1", title: "游梦洄廊" },
  { version: "1.0", title: "公测" },
];
const versionPools = versionMeta.map((meta) => ({
  ...meta,
  reruns: meta.reruns ?? [],
  characters: allCharacters
    .filter((character) => character.pool?.version === meta.version)
    .sort((a, b) => (a.pool?.phase === "上半" ? -1 : 1) - (b.pool?.phase === "上半" ? -1 : 1)),
}));
const permanentCharacters = allCharacters
  .filter((character) => !character.pool)
  .sort((a, b) => (a.rarity === b.rarity ? 0 : a.rarity === "S" ? -1 : 1));
const permanentTiers = ["S", "A"].map((rarity) => ({
  rarity,
  characters: permanentCharacters.filter((character) => character.rarity === rarity),
}));
---

<BaseLayout
  title="卡池信息"
  description="《异环》国服限定卡池时间线与常驻角色资料，按版本从新到旧排列。"
  active="/characters/"
>
  <PageHero
    eyebrow="国服卡池"
    title="卡池信息"
    description="限定卡池按版本从新到旧排列；常驻角色按 S、A 稀有度依次收录。"
  />

  <div class="pool-timeline">
    {
      versionPools.map((pool) => (
        <section class="pool-version" aria-labelledby={`pool-version-${pool.version.replace(".", "-")}`}>
          <header class="pool-version-header">
            <div>
              <p class="pool-version-kicker">VERSION</p>
              <h2 id={`pool-version-${pool.version.replace(".", "-")}`}>{pool.version}</h2>
            </div>
            <p>{pool.title}</p>
          </header>
          <div class="pool-pair">
            {pool.characters.map((character) => (
              <CharacterPoolCard character={character} />
            ))}
          </div>
          {
            pool.reruns.length > 0 && (
              <p class="pool-reruns">
                <strong>复刻：</strong>
                {pool.reruns.map((rerun, index) => (
                  <>
                    {index > 0 && "；"}
                    <span>{rerun.phase} </span>
                    <a href={`#character-${rerun.characterId}-first-pool`}>{rerun.characterName}</a>
                  </>
                ))}
              </p>
            )
          }
        </section>
      ))
    }
  </div>

  <section class="permanent-pool" aria-labelledby="permanent-pool-title">
    <header class="permanent-pool-header">
      <div>
        <p class="pool-version-kicker">STANDARD</p>
        <h2 id="permanent-pool-title">常驻</h2>
      </div>
      <p>常驻角色不标注卡池时间，S 级在前，A 级在后。</p>
    </header>

    {
      permanentTiers.map((tier) => (
        <section class="permanent-tier" aria-labelledby={`permanent-tier-${tier.rarity}`}>
          <div class="permanent-tier-heading">
            <h3 id={`permanent-tier-${tier.rarity}`}>{tier.rarity} 级</h3>
            <span>{tier.characters.length} 位角色</span>
          </div>
          <div class="permanent-grid">
            {tier.characters.map((character) => (
              <CharacterPoolCard character={character} permanent />
            ))}
          </div>
        </section>
      ))
    }
  </section>

  <p class="pool-note">卡池日期采用中国服务器日期，开始日以对应版本维护完成为准。</p>
</BaseLayout>
