---
import BaseLayout from "@/components/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import { withBase } from "@/lib/site";

const sections = [
  {
    href: "/tasks/",
    title: "海市事务",
    summary: "日常、周常、双周常与周期刷新事项。",
  },
  {
    href: "/characters/",
    title: "卡池信息",
    summary: "国服限定卡池时间线与常驻角色资料。",
  },
  {
    href: "/affinity/",
    title: "好感度",
    summary: "角色赠礼性价比与等级升级需求。",
  },
  {
    href: "/terms/",
    title: "名词解释",
    summary: "整理养成与系统术语，并提供近似概念对应。",
  },
  {
    href: "/translations/",
    title: "中英对照",
    summary: "角色名、地点、道具和系统词的中英对照。",
  },
  {
    href: "/links/",
    title: "外部链接",
    summary: "官网、下载、Wiki、社区与相关工具入口。",
  },
];
---

<BaseLayout active="/">
  <PageHero
    eyebrow="异环手账"
    title="一个异环轻量资料站"
    description="收纳异环的周期事项、国服卡池、术语解释、中英对照和外部链接。"
  />

  <section>
    <SectionHeader
      title="板块"
      description="从这里进入各个资料区。"
    />
    <div class="grid">
      {
        sections.map((section) => (
          <a class="card" href={withBase(section.href)}>
            <h3>{section.title}</h3>
            <p>{section.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="notice">
    本站为非官方玩家项目。条目内容会优先保持轻量、可检索和可维护，详细攻略与深度养成会尽量链接到更专业的资料站。
  </section>
</BaseLayout>
