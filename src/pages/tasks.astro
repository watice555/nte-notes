---
import BaseLayout from "@/components/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import tasks from "@/data/tasks.json";

const categoryLabels: Record<string, string> = {
  daily: "每日",
  weekly: "每周",
  biweekly: "双周",
  monthly: "每月",
  version: "版本",
};

const groups = [
  {
    key: "daily",
    title: "日常",
    description: "每日刷新或适合每天顺手检查的事项。",
  },
  {
    key: "weekly",
    title: "周常",
    description: "每周刷新、结算或限次领取的事项。",
  },
  {
    key: "biweekly",
    title: "双周常",
    description: "双周轮换或阶段性周期内容。",
  },
  {
    key: "monthly",
    title: "月常",
    description: "每月刷新或适合按月检查的兑换内容。",
  },
  {
    key: "version",
    title: "版本任务",
    description: "随版本活动、卡池和商店周期变化的事项。",
  },
];

const buildTaskMarkdown = () => {
  const lines = [
    "# 海市事务",
    "",
    "用于整理日常、周常等周期刷新事项。条目会保留刷新周期和简短说明。",
    "",
  ];

  groups.forEach((group) => {
    const items = tasks.filter((task) => task.category === group.key);
    if (items.length === 0) return;

    lines.push(`## ${group.title}`, "");
    items.forEach((task) => {
      const title = task.title;
      const summary = task.summary.replace(/\n/g, "\n  ");
      lines.push(`- **${title}**: ${summary}`);
    });
    lines.push("");
  });

  return lines.join("\n").trim();
};

const taskMarkdown = buildTaskMarkdown();

const buildTaskText = () => {
  const lines = [
    "海市事务",
    "",
    "用于整理日常、周常等周期刷新事项。条目会保留刷新周期和简短说明。",
    "",
  ];

  groups.forEach((group) => {
    const items = tasks.filter((task) => task.category === group.key);
    if (items.length === 0) return;

    lines.push(group.title, "");
    items.forEach((task) => {
      lines.push(`${task.title}: ${task.summary}`);
    });
    lines.push("");
  });

  return lines.join("\n").trim();
};

const taskText = buildTaskText();
---

<BaseLayout title="海市事务" active="/tasks/">
  <PageHero
    eyebrow="事务清单"
    title="海市事务"
    description="用于整理日常、周常等周期刷新事项。条目会保留刷新周期和简短说明。"
    quips={["打工人，打工魂"]}
  />

  <div class="page-action-row">
    <button
      class="copy-button"
      type="button"
      data-copy-content
      data-copy-text={taskMarkdown}
    >
      复制为 Markdown
    </button>
    <button
      class="copy-button"
      type="button"
      data-copy-content
      data-copy-text={taskText}
    >
      复制为文本
    </button>
    <span class="copy-status" data-copy-status hidden>
      已复制
    </span>
  </div>

  {
    groups.map((group) => {
      const items = tasks.filter((task) => task.category === group.key);
      if (items.length === 0) return null;

      return (
        <section>
          <SectionHeader
            title={group.title}
            description={group.description}
          />
          <div class="grid">
            {items.map((task) => (
              <article class="data-card">
                <div class="meta-row">
                  <span class="pill">{categoryLabels[task.category] ?? task.category}</span>
                </div>
                <h3>{task.title}</h3>
                <p>{task.summary}</p>
              </article>
            ))}
          </div>
        </section>
      );
    })
  }
</BaseLayout>

<script>
  // @ts-nocheck
  const copyButtons = Array.from(document.querySelectorAll("[data-copy-content]"));
  const copyStatus = document.querySelector("[data-copy-status]");

  const fallbackCopy = (text) => {
    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "fixed";
    textarea.style.left = "-9999px";
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand("copy");
    textarea.remove();
  };

  copyButtons.forEach((copyButton) => {
    copyButton.addEventListener("click", async () => {
      const text = copyButton.getAttribute("data-copy-text") || "";

      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
        } else {
          fallbackCopy(text);
        }

        if (copyStatus) {
          copyStatus.hidden = false;
          window.clearTimeout(copyStatus.dataset.timer);
          copyStatus.dataset.timer = String(window.setTimeout(() => {
            copyStatus.hidden = true;
          }, 1800));
        }
      } catch {
        fallbackCopy(text);
        if (copyStatus) copyStatus.hidden = false;
      }
    });
  });
</script>
