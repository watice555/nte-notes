---
interface Props {
  eyebrow?: string;
  title: string;
  titleEn?: string;
  description: string;
  descriptionEn?: string;
  quips?: string[];
}

const {
  eyebrow,
  title,
  description,
  quips = [],
} = Astro.props;
---

<section class="page-hero">
  <div class="hero-copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
  {
    quips.length > 0 && (
      <div
        class="hero-quips"
        aria-label="栏目吐槽"
        data-random-quips={JSON.stringify(quips)}
      >
        <span class="hero-quip">
          “{quips[0]}”
        </span>
      </div>
    )
  }
</section>

<script>
  document.querySelectorAll("[data-random-quips]").forEach((container) => {
    const rawQuips = container.getAttribute("data-random-quips");
    const target = container.querySelector(".hero-quip");
    if (!rawQuips || !target) return;

    try {
      const quips = JSON.parse(rawQuips);
      if (!Array.isArray(quips) || quips.length === 0) return;

      const index = Math.floor(Math.random() * quips.length);
      target.textContent = `“${quips[index] ?? quips[0]}”`;
    } catch {
      // Keep the server-rendered fallback if the data attribute is malformed.
    }
  });
</script>
