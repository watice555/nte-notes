---
import { site, withBase } from "@/lib/site";

interface Props {
  active: string;
}

const { active } = Astro.props;
const assetBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const navEn: Record<string, string> = {
  "/": "Home",
  "/tasks/": "Hethereau Affairs",
  "/bugs/": "Bugs",
  "/characters/": "Characters",
  "/terms/": "Glossary",
  "/translations/": "CN/EN",
  "/links/": "Links",
  "/about/": "About",
};
---

<header class="site-header">
  <a class="brand" href={withBase("/")} aria-label="异环手账首页">
    <span class="brand-mark" aria-hidden="true">
      <img src={`${assetBase}site-icon.png`} alt="" />
    </span>
    <span>
      <strong data-i18n-zh={site.zhName} data-i18n-en={site.enName}>{site.zhName}</strong>
      <small>NTE Notes</small>
    </span>
  </a>
  <nav class="site-nav" aria-label="主导航">
    {
      site.nav.map((item) => (
        <a
          href={withBase(item.href)}
          aria-current={active === item.href ? "page" : undefined}
          data-i18n-zh={item.label}
          data-i18n-en={navEn[item.href]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="header-actions">
    <button class="icon-button" type="button" data-search-open aria-label="打开搜索">
      搜索
    </button>
    <button class="lang-toggle" type="button" data-lang-toggle aria-pressed="false">
      中 / EN
    </button>
  </div>
</header>
