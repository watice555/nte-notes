---
import SiteHeader from "./SiteHeader.astro";
import SearchPanel from "./SearchPanel.astro";
import { site } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const { title, description = site.description, active = "/" } = Astro.props;
const pageTitle = title ? `${title} · ${site.zhName}` : site.zhName;
const assetBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href={`${assetBase}site-icon.png`} />
    <link rel="apple-touch-icon" href={`${assetBase}site-icon.png`} />
    <link rel="stylesheet" href={`${assetBase}styles/global.css`} />
  </head>
  <body>
    <div class="app-shell">
      <SiteHeader active={active} />
      <div class="content-shell">
        <SearchPanel />
        <main id="main" data-pagefind-body>
          <slot />
        </main>
        <footer class="site-footer">
          <p>非官方玩家项目。游戏内容、商标与相关素材归各自权利方所有。</p>
          <p>Built for GitHub Pages · <span lang="en">NTE Notes</span></p>
        </footer>
      </div>
    </div>
  </body>
</html>
